# This file also ships to the live student repo via sync_to_live.py, so it keeps a
# student's clone clean once they start running notebooks.

# Python
__pycache__/
*.py[cod]

# Jupyter autosave checkpoints
.ipynb_checkpoints/

# LaTeX build output — keep the .tex, not these
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc

# Student submissions never enter this repo; they stay in the LMS.
